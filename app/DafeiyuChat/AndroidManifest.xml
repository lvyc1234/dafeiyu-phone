<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.deepseek.dafeiyu.chat"
    android:versionCode="3"
    android:versionName="1.2.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- API 19 = Android 4.4 -->
    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="34" />

    <queries>
        <package android:name="org.autojs.autoxjs.v6" />
        <package android:name="org.autojs.autojs" />
        <package android:name="org.autojs.autojs6" />
        <package android:name="com.stardust.autojs" />
    </queries>

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="大肥鱼"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
